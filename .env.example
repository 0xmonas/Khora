# AI — Option A: Vertex AI (recommended, higher rate limits)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# A1: Local dev — file-based service account key
GOOGLE_APPLICATION_CREDENTIALS=./keys/your-service-account.json

# A2: Vercel / serverless — base64-encoded service account key
# GOOGLE_SERVICE_ACCOUNT_KEY=   # cat keys/your-key.json | base64

# AI — Option B: AI Studio (fallback, lower rate limits)
GEMINI_API_KEY=

# Wallet & NFT Contract
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_BOOA_NFT_ADDRESS=
NEXT_PUBLIC_BOOA_NFT_ADDRESS_TESTNET=

# SIWE Session (iron-session, 32+ chars)
SESSION_SECRET=

# Upstash Redis (rate limiting + metadata cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Replicate (FLUX image generation)
REPLICATE_API_TOKEN=

# AI Model Overrides (optional — defaults are set in code)
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite-preview
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite-preview
# REPLICATE_FLUX_MODEL=0xmonas/y2:...

# Cloudflare Turnstile (bot protection for waitlist)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Waitlist Admin (used to open/close waitlist and export addresses)
WAITLIST_ADMIN_SECRET=

# OpenSea (for BOOASK collection stats, listings, recent sales)
OPENSEA_API_KEY=

# BOOASK daily caps (cost protection; defaults shown)
# BOOASK_DAILY_PER_IP_MAX=30      # max questions/day per IP
# BOOASK_DAILY_GLOBAL_MAX=5000    # global daily cap (~$15/day worst case on Flash Lite)
# BOOASK_DEBUG=0                  # set to 1 for tool-loop trace logs

# Agent Chat global daily cap (cost ceiling on top of per-wallet 10 limit)
# AGENT_CHAT_DAILY_GLOBAL_MAX=5000  # default; BYOK users bypass this

# ─── Shape → Ethereum Migration (burn-to-claim) ───
# Set these AFTER deploying the migration contracts. While empty, /migrate
# shows "not live yet" and the ticket endpoint returns 503.
#
# Ethereum BOOAEth contract (public — the claim target)
NEXT_PUBLIC_BOOA_ETH_ADDRESS=
# Shape BOOABurnHelper contract (public — batch burn)
NEXT_PUBLIC_BOOA_BURN_HELPER_ADDRESS=
# Operator signing key — signs claim tickets after verifying Shape burns.
# HOT key: hold in KMS/HSM in production, NOT a plaintext file. Separate from
# SIGNER_PRIVATE_KEY. Its address must equal BOOAEth.operatorSigner.
MIGRATION_OPERATOR_PRIVATE_KEY=
# Optional tuning (defaults shown)
# MIGRATION_CONFIRMATIONS=10        # Shape blocks before a burn is signable
# MIGRATION_BURN_LOOKBACK=2000000   # blocks to scan for burn events
# ETH_RPC_URL=                      # Ethereum RPC for claimed() checks
# SHAPE_RPC_URL=                    # Shape RPC (defaults to mainnet.shape.network)

# ─── Adapter8004 binding (ERC-8217) — Premm's canonical Safe-owned proxies ───
# Public canonical addresses. Code has these as hardcoded fallback in
# booa-adapter.ts; env overrides per chain. Binding is LIVE on Ethereum + Base.
NEXT_PUBLIC_BOOA_ADAPTER_ADDRESS_ETH=0xde152AfB7db5373F34876E1499fbD893A82dD336
NEXT_PUBLIC_BOOA_ADAPTER_ADDRESS_BASE=0x270d25D2c59A8bcA1B0f40ad95fF7806c0025c27
# Shape mainnet has no canonical adapter yet (empty). Sepolia is our test fixture.
# NEXT_PUBLIC_BOOA_ADAPTER_ADDRESS=
# NEXT_PUBLIC_BOOA_ADAPTER_ADDRESS_TESTNET=0xC1C6290413ADc62efedC2642C51BC7F261Ab7685
